# vLLM Configuration
VLLM_BASE_URL=https://your-runpod-pod-id-8000.proxy.runpod.net/v1
VLLM_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct
VLLM_MAX_TOKENS=4096
VLLM_TEMPERATURE=0.1

# PDF Processing Configuration
PDF_DPI=150
PDF_MAX_PAGES=10
MAX_UPLOAD_SIZE_MB=20
# Allowed Tags and System Prompts
ALLOWED_TAGS=BMR,COA,prescription,lab_report,discharge_summary,radiology_report
SYSTEM_PROMPTS_PATH=app/system_prompts.json
CONCURRENCY_LIMIT=2
CHUNK_SIZE=8

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
